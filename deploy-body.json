{"name": "psych-alex", "project": "psych-alex", "target": "production", "projectSettings": {"framework": null, "buildCommand": null, "outputDirectory": null, "installCommand": null}, "files": [{"file": "index.html", "encoding": "utf-8", "data": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Psychiatric Provider \u2014 Find therapists, psychiatrists & group practices</title>\n<meta name=\"description\" content=\"Psychiatric Provider: find therapists, psychiatrists, and group practices with verified openings. Prototype with sample data.\">\n<meta name=\"theme-color\" content=\"#2f6f62\">\n<style>\n/* ===== THEME ===== */\n:root{--bg:#f4f8f7;--card:#fff;--ink:#1f2d2b;--muted:#5b6b68;--brand:#2f6f62;--brand2:#3d7fa6;--soft:#e3efec;--warn:#9a5b00;--warnbg:#fff4e0;--ok:#1e6b3a;--okbg:#e4f5ea;--line:#d6e2df;--r:12px}\n*{box-sizing:border-box}\nbody{margin:0;font:16px/1.5 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;background:var(--bg);color:var(--ink)}\na{color:var(--brand2)}\nbutton,select,input,textarea{font:inherit}\n.crisis{background:#7a1f2b;color:#fff;padding:.5rem 1rem;text-align:center;font-size:.9rem;position:sticky;top:0;z-index:20}\n.crisis a{color:#fff;font-weight:700}\nheader{background:var(--card);border-bottom:1px solid var(--line);padding:.6rem 1rem;display:flex;gap:.75rem;align-items:center;flex-wrap:wrap}\nheader .logo{font-weight:800;color:var(--brand);text-decoration:none;font-size:1.15rem;margin-right:auto;white-space:nowrap}\nheader nav{display:flex;flex-wrap:wrap;gap:.35rem .9rem;align-items:center}\nheader nav a{margin:0;text-decoration:none;color:var(--ink);font-size:.95rem;white-space:nowrap}\nmain{max-width:980px;margin:0 auto;padding:1rem}\n.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:1rem;margin:.75rem 0}\n.hero{background:linear-gradient(135deg,var(--soft),#e6f0f7);border-radius:var(--r);padding:1.4rem 1.25rem 1.5rem}\n.sentence{font-size:1.1rem;line-height:1.85;display:flex;flex-direction:column;gap:.85rem}\n.sentence .line{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem .5rem}\n.sentence select{padding:.4rem .55rem;border:2px solid var(--brand);border-radius:8px;background:#fff;color:var(--brand);font-weight:600;max-width:100%}\n.sentence .actions{margin-top:.35rem}\n.btn{background:var(--brand);color:#fff;border:0;border-radius:10px;padding:.6rem 1rem;cursor:pointer;font-weight:600}\n.btn.alt{background:#fff;color:var(--brand);border:2px solid var(--brand)}\n.btn.sm{padding:.3rem .6rem;font-size:.85rem}\n.btn:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #f0b429;outline-offset:2px}\n.chips{display:flex;flex-wrap:wrap;gap:.5rem;margin:.75rem 0}\n.chip{border:1px solid var(--brand);background:#fff;color:var(--brand);border-radius:999px;padding:.3rem .8rem;cursor:pointer;font-size:.9rem;text-decoration:none}\n.chip.on{background:var(--brand);color:#fff}\n.tag{display:inline-block;background:var(--soft);border-radius:6px;padding:.1rem .45rem;margin:.1rem;font-size:.8rem}\n.row{display:flex;gap:1rem;align-items:flex-start}\n.avatar{width:64px;height:64px;border-radius:50%;flex:none;display:grid;place-items:center;color:#fff;font-weight:700;font-size:1.3rem}\n.muted{color:var(--muted);font-size:.9rem}\n.open{border-radius:8px;padding:.35rem .6rem;font-size:.88rem;margin-top:.4rem}\n.open.ok{background:var(--okbg);color:var(--ok)}\n.open.stale{background:var(--warnbg);color:var(--warn)}\n.open.none{background:#eee;color:#555}\n.filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.5rem}\n.filters select,.filters input,form input,form select,form textarea{width:100%;padding:.5rem;border:1px solid var(--line);border-radius:8px;background:#fff}\n.toggle{display:inline-flex;border:2px solid var(--brand);border-radius:10px;overflow:hidden;margin:.5rem 0}\n.toggle button{border:0;background:#fff;color:var(--brand);padding:.4rem .9rem;cursor:pointer;font-weight:600}\n.toggle button[aria-pressed=true]{background:var(--brand);color:#fff}\n.fav{background:none;border:1px solid var(--line);border-radius:8px;cursor:pointer;padding:.25rem .5rem}\n.fav[aria-pressed=true]{color:#b3263e;border-color:#b3263e}\nlabel{display:block;margin:.6rem 0 .2rem;font-weight:600;font-size:.92rem}\n.note{background:var(--warnbg);border-left:4px solid var(--warn);padding:.6rem .8rem;border-radius:6px;font-size:.9rem}\n.success{background:var(--okbg);border-left:4px solid var(--ok);padding:.75rem;border-radius:6px}\n.team{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:.6rem}\nfooter{text-align:center;color:var(--muted);font-size:.85rem;padding:2rem 1rem}\n.homebar{display:flex;gap:.5rem;align-items:center;margin:0 0 .75rem;position:sticky;top:2.6rem;z-index:15;background:var(--bg);padding:.4rem 0}\n.homebar .btn{box-shadow:0 1px 0 #0001}\n.homebar .spacer{flex:1}\n.page-actions{display:flex;flex-wrap:wrap;gap:.5rem;margin:1.25rem 0 .5rem}\n.btn.danger{background:#fff;color:#9d1612;border:2px solid #9d1612}\n@media(max-width:600px){.row{flex-direction:column}.sentence{font-size:1rem}.sentence .line{gap:.35rem}}\n</style>\n</head>\n<body>\n<!-- ===== DIFFERENTIATOR 6: 988 CRISIS BANNER ===== -->\n<div class=\"crisis\" role=\"alert\">In crisis? Call or text <a href=\"tel:988\">988</a> (Suicide &amp; Crisis Lifeline) or call 911. This directory is not for emergencies.</div>\n<header>\n  <a class=\"logo\" href=\"#/\" id=\"logo\" data-nav=\"/\">Psychiatric Provider</a>\n  <button type=\"button\" class=\"btn alt sm\" id=\"homeBtn\" data-home style=\"display:none\">\u2190 Home</button>\n  <nav aria-label=\"Main\">\n    <button type=\"button\" class=\"chip\" id=\"navSearchBtn\" data-run-search>Search</button>\n    <a href=\"#/specialty/emdr/frisco\" data-nav=\"/specialty/emdr/frisco\">EMDR</a>\n    <a href=\"#/specialty/play-therapy/mckinney\" data-nav=\"/specialty/play-therapy/mckinney\">Play therapy</a>\n    <a href=\"#/saved\" data-nav=\"/saved\">Saved (<span id=\"savedCount\">0</span>)</a>\n    <a href=\"#/join\" data-nav=\"/join\">For practices</a>\n  </nav>\n</header>\n<main id=\"app\" tabindex=\"-1\"></main>\n<footer>Prototype \u00b7 all clinicians, practices, and openings are fictional sample data \u00b7 nothing is sent anywhere.</footer>\n\n<script>\n/* ===== CONFIG: change the brand name here (one line) ===== */\nconst BRAND = \"Psychiatric Provider\";\n\nconst TODAY = new Date(); // stale check uses the real current date\nconst STALE_DAYS = 30;\n\n/* ===== SAMPLE DATA (fictional) ===== */\nconst SPECIALTIES = {\"emdr\":\"EMDR\",\"play-therapy\":\"Play therapy\",\"trauma\":\"Trauma\",\"adhd\":\"ADHD\",\"couples\":\"Couples\",\"anxiety\":\"Anxiety\",\"depression\":\"Depression\",\"medication\":\"Medication management\"};\nconst CITIES = {\"frisco\":\"Frisco\",\"southlake\":\"Southlake\",\"mckinney\":\"McKinney\",\"lewisville\":\"Lewisville\"};\nconst INSURERS = [\"Aetna\",\"Blue Cross Blue Shield\",\"Cigna\",\"UnitedHealthcare\",\"Medicaid\",\"Self-pay\"];\n\nconst PRACTICES = [\n {id:\"clean-page\",name:\"Clean Page Counseling Group\",city:\"frisco\",about:\"Group practice focused on trauma recovery, EMDR, and family work.\",insurance:[\"Aetna\",\"Cigna\",\"Blue Cross Blue Shield\",\"Self-pay\"],phone:\"(555) 010-2001\",intake:true},\n {id:\"willow-path\",name:\"Willow Path Family Therapy\",city:\"mckinney\",about:\"Child, teen, and family therapy with a dedicated play therapy room.\",insurance:[\"Aetna\",\"Medicaid\",\"UnitedHealthcare\",\"Self-pay\"],phone:\"(555) 010-2002\",intake:true},\n {id:\"lakeside-mind\",name:\"Lakeside Mind & Medication\",city:\"lewisville\",about:\"Psychiatric evaluations, medication management, and therapy under one roof.\",insurance:[\"Blue Cross Blue Shield\",\"UnitedHealthcare\",\"Aetna\"],phone:\"(555) 010-2003\",intake:true},\n {id:\"oak-harbor\",name:\"Oak Harbor Counseling\",city:\"southlake\",about:\"Couples and individual therapy for adults.\",insurance:[\"Cigna\",\"Self-pay\"],phone:\"(555) 010-2004\",intake:true}\n];\n\nconst CLINICIANS = [\n {id:\"maya-reyes\",name:\"Maya Reyes\",cred:\"LPC-S\",practice:\"clean-page\",city:\"frisco\",specialties:[\"emdr\",\"trauma\",\"anxiety\"],insurance:[\"Aetna\",\"Cigna\",\"Self-pay\"],langs:[\"English\",\"Spanish\"],telehealth:true,nextOpening:\"2026-11-04\",lastConfirmed:\"2026-10-27\",bio:\"I help adults heal from trauma using EMDR in a calm, paced way.\"},\n {id:\"daniel-okafor\",name:\"Daniel Okafor\",cred:\"LCSW\",practice:\"clean-page\",city:\"frisco\",specialties:[\"trauma\",\"depression\",\"adhd\"],insurance:[\"Aetna\",\"Blue Cross Blue Shield\"],langs:[\"English\"],telehealth:true,nextOpening:null,lastConfirmed:\"2026-10-21\",bio:\"Practical, warm therapy for adults managing ADHD, depression, and stress.\"},\n {id:\"priya-nair\",name:\"Priya Nair\",cred:\"LMFT\",practice:\"clean-page\",city:\"frisco\",specialties:[\"emdr\",\"couples\"],insurance:[\"Cigna\",\"Self-pay\"],langs:[\"English\",\"Hindi\"],telehealth:false,nextOpening:\"2026-11-10\",lastConfirmed:\"2026-08-30\",bio:\"Couples work and EMDR for relationship trauma.\"},\n {id:\"hannah-cole\",name:\"Hannah Cole\",cred:\"LPC, RPT\",practice:\"willow-path\",city:\"mckinney\",specialties:[\"play-therapy\",\"anxiety\",\"adhd\"],insurance:[\"Aetna\",\"Medicaid\"],langs:[\"English\"],telehealth:false,nextOpening:\"2026-11-02\",lastConfirmed:\"2026-10-25\",bio:\"Registered Play Therapist working with kids ages 3\u201312.\"},\n {id:\"luis-garza\",name:\"Luis Garza\",cred:\"LMFT\",practice:\"willow-path\",city:\"mckinney\",specialties:[\"play-therapy\",\"couples\",\"trauma\"],insurance:[\"UnitedHealthcare\",\"Medicaid\",\"Self-pay\"],langs:[\"English\",\"Spanish\"],telehealth:true,nextOpening:\"2026-11-15\",lastConfirmed:\"2026-09-12\",bio:\"Family systems and play therapy; bilingual sessions available.\"},\n {id:\"ava-brooks\",name:\"Ava Brooks\",cred:\"LPC Associate\",practice:\"willow-path\",city:\"mckinney\",specialties:[\"play-therapy\",\"emdr\"],insurance:[\"Aetna\",\"Self-pay\"],langs:[\"English\"],telehealth:false,nextOpening:\"2026-10-31\",lastConfirmed:\"2026-10-28\",bio:\"Child-centered play therapy and EMDR adapted for kids.\"},\n {id:\"samir-haddad\",name:\"Dr. Samir Haddad\",cred:\"MD, Psychiatrist\",practice:\"lakeside-mind\",city:\"lewisville\",specialties:[\"medication\",\"adhd\",\"depression\"],insurance:[\"Blue Cross Blue Shield\",\"UnitedHealthcare\"],langs:[\"English\",\"Arabic\"],telehealth:true,nextOpening:\"2026-11-20\",lastConfirmed:\"2026-10-15\",bio:\"Board-certified adult psychiatrist.\"},\n {id:\"grace-lin\",name:\"Grace Lin\",cred:\"PMHNP-BC\",practice:\"lakeside-mind\",city:\"lewisville\",specialties:[\"medication\",\"anxiety\"],insurance:[\"Aetna\",\"Blue Cross Blue Shield\"],langs:[\"English\",\"Mandarin\"],telehealth:true,nextOpening:\"2026-11-06\",lastConfirmed:\"2026-07-20\",bio:\"Psychiatric nurse practitioner for anxiety and mood.\"},\n {id:\"tom-becker\",name:\"Tom Becker\",cred:\"LMFT\",practice:\"oak-harbor\",city:\"southlake\",specialties:[\"couples\",\"depression\"],insurance:[\"Cigna\",\"Self-pay\"],langs:[\"English\"],telehealth:true,nextOpening:\"2026-11-03\",lastConfirmed:\"2026-10-24\",bio:\"Gottman-informed couples therapy.\"},\n {id:\"rachel-stein\",name:\"Rachel Stein\",cred:\"LPC\",practice:null,city:\"southlake\",specialties:[\"emdr\",\"trauma\",\"anxiety\"],insurance:[\"Aetna\",\"UnitedHealthcare\"],langs:[\"English\"],telehealth:true,nextOpening:\"2026-11-08\",lastConfirmed:\"2026-10-19\",bio:\"Solo practice; EMDR intensives for single-incident trauma.\"},\n {id:\"marco-silva\",name:\"Marco Silva\",cred:\"LCSW\",practice:null,city:\"frisco\",specialties:[\"adhd\",\"play-therapy\"],insurance:[\"Medicaid\",\"Self-pay\"],langs:[\"English\",\"Portuguese\",\"Spanish\"],telehealth:false,nextOpening:null,lastConfirmed:\"2026-08-01\",bio:\"Solo practice for kids and teens with ADHD.\"}\n];\n\n/* ===== STORAGE (localStorage only) ===== */\nconst LS = {\n get(k,d){try{return JSON.parse(localStorage.getItem(k))??d}catch(e){return d}},\n set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}\n};\n\n/* ===== HELPERS ===== */\nconst $ = s => document.querySelector(s);\nconst esc = s => String(s??\"\").replace(/[&<>\"']/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\",\"'\":\"&#39;\"}[c]));\nconst fmt = iso => new Date(iso+\"T12:00:00\").toLocaleDateString(\"en-US\",{month:\"short\",day:\"numeric\",year:\"numeric\"});\nconst daysSince = iso => Math.floor((TODAY - new Date(iso+\"T12:00:00\"))/864e5);\nconst practiceOf = c => PRACTICES.find(p=>p.id===c.practice);\nconst teamOf = p => CLINICIANS.filter(c=>c.practice===p.id);\nconst initials = n => n.replace(\"Dr. \",\"\").split(\" \").map(w=>w[0]).join(\"\");\nconst color = id => [\"#2f6f62\",\"#3d7fa6\",\"#6a5d9e\",\"#a6643d\",\"#4f7d3a\"][id.length%5];\n\n/* ===== DIFFERENTIATOR 2: STRUCTURED OPENINGS + STALE FLAG ===== */\nfunction isStale(c){return daysSince(c.lastConfirmed) > STALE_DAYS}\nfunction isOpen(c){return !!c.nextOpening && !isStale(c)}\nfunction openingBadge(c){\n  const conf = `last confirmed ${fmt(c.lastConfirmed)}`;\n  if(isStale(c)) return `<div class=\"open stale\">\u26a0 Possibly out of date \u2014 ${c.nextOpening?\"next opening listed as \"+fmt(c.nextOpening):\"no opening listed\"}; ${conf} (${daysSince(c.lastConfirmed)} days ago)</div>`;\n  if(!c.nextOpening) return `<div class=\"open none\">Not accepting new clients \u00b7 ${conf}</div>`;\n  return `<div class=\"open ok\">\u2713 Next opening ${fmt(c.nextOpening)} \u00b7 ${conf}</div>`;\n}\nfunction practiceOpenings(p){\n  const t = teamOf(p), open = t.filter(isOpen).sort((a,b)=>a.nextOpening.localeCompare(b.nextOpening));\n  return open.length ? `<div class=\"open ok\">\u2713 ${open.length} of ${t.length} clinicians have verified openings \u00b7 soonest ${fmt(open[0].nextOpening)}</div>`\n                     : `<div class=\"open none\">No verified openings right now</div>`;\n}\n\n/* ===== DIFFERENTIATOR 8: FAVORITES (clinicians + practices) ===== */\nfunction favs(){return LS.get(\"pp_favs\",{c:[],p:[]})}\nfunction isFav(t,id){return favs()[t].includes(id)}\nfunction toggleFav(t,id){const f=favs();f[t]=f[t].includes(id)?f[t].filter(x=>x!==id):[...f[t],id];LS.set(\"pp_favs\",f);updateCount();route()}\nfunction favBtn(t,id){const on=isFav(t,id);return `<button type=\"button\" class=\"fav\" aria-pressed=\"${on}\" data-fav=\"${t}\" data-id=\"${id}\">${on?\"\u2665 Saved\":\"\u2661 Save\"}</button>`}\nfunction updateCount(){const f=favs();$(\"#savedCount\").textContent=f.c.length+f.p.length}\n\n/* ===== CARDS ===== */\nfunction clinicianCard(c){\n  const p = practiceOf(c);\n  return `<article class=\"card\"><div class=\"row\">\n   <div class=\"avatar\" style=\"background:${color(c.id)}\" aria-hidden=\"true\">${initials(c.name)}</div>\n   <div style=\"flex:1\"><h3 style=\"margin:0\"><a href=\"#/clinician/${c.id}\">${esc(c.name)}</a>, <span class=\"muted\">${esc(c.cred)}</span></h3>\n   <div class=\"muted\">${CITIES[c.city]}, TX \u00b7 ${p?`<a href=\"#/practice/${p.id}\">${esc(p.name)}</a>`:\"Solo practice\"}${c.telehealth?\" \u00b7 Telehealth\":\"\"}</div>\n   <div>${c.specialties.map(s=>`<span class=\"tag\">${SPECIALTIES[s]}</span>`).join(\"\")}</div>\n   <div class=\"muted\">Insurance: ${c.insurance.join(\", \")}</div>\n   ${openingBadge(c)}\n   <div style=\"margin-top:.5rem;display:flex;gap:.5rem;flex-wrap:wrap\"><a class=\"btn sm\" href=\"#/request/clinician/${c.id}\">Request appointment</a>${favBtn(\"c\",c.id)}</div>\n   </div></div></article>`;\n}\nfunction practiceCard(p){\n  const t = teamOf(p);\n  const specs=[...new Set(t.flatMap(c=>c.specialties))];\n  return `<article class=\"card\"><h3 style=\"margin:0\"><a href=\"#/practice/${p.id}\">${esc(p.name)}</a></h3>\n   <div class=\"muted\">Group practice \u00b7 ${CITIES[p.city]}, TX \u00b7 ${t.length} clinicians</div>\n   <div>${specs.map(s=>`<span class=\"tag\">${SPECIALTIES[s]}</span>`).join(\"\")}</div>\n   <div class=\"muted\">Insurance: ${p.insurance.join(\", \")}</div>\n   ${practiceOpenings(p)}\n   <div style=\"margin-top:.5rem;display:flex;gap:.5rem;flex-wrap:wrap\"><a class=\"btn sm\" href=\"#/request/practice/${p.id}\">Request \u2014 match me to a clinician</a>${favBtn(\"p\",p.id)}</div></article>`;\n}\n\n/* ===== SEARCH / FILTER LOGIC ===== */\nfunction filterClinicians(q){\n  return CLINICIANS.filter(c=>\n    (!q.specialty||c.specialties.includes(q.specialty)) &&\n    (!q.city||c.city===q.city) &&\n    (!q.insurance||c.insurance.includes(q.insurance)) &&\n    (!q.type||(q.type===\"group\"?!!c.practice:!c.practice)) &&\n    (!q.open||isOpen(c)) &&\n    (!q.tele||c.telehealth)\n  ).sort((a,b)=>(isOpen(b)-isOpen(a))||((a.nextOpening||\"9\")>(b.nextOpening||\"9\")?1:-1));\n}\nfunction filterPractices(q){\n  if(q.type===\"solo\") return [];\n  return PRACTICES.filter(p=>{\n    const t=teamOf(p);\n    return (!q.city||p.city===q.city)&&(!q.insurance||p.insurance.includes(q.insurance))&&\n      (!q.specialty||t.some(c=>c.specialties.includes(q.specialty)))&&(!q.open||t.some(isOpen));\n  });\n}\nfunction toQuery(o){return new URLSearchParams(Object.entries(o).filter(([,v])=>v)).toString()}\nconst opts=(obj,sel,blank)=>`<option value=\"\">${blank}</option>`+Object.entries(obj).map(([k,v])=>`<option value=\"${k}\"${k===sel?\" selected\":\"\"}>${v}</option>`).join(\"\");\nconst insOpts=(sel,blank)=>`<option value=\"\">${blank}</option>`+INSURERS.map(i=>`<option${i===sel?\" selected\":\"\"}>${i}</option>`).join(\"\");\n\n/* ===== VIEWS ===== */\nconst views = {\n/* DIFFERENTIATOR 3: ONE-SENTENCE SEARCH + QUICK CHIPS */\nhome(){\n  return `<section class=\"hero\"><h1 style=\"margin-top:0\">Find care that actually has room for you.</h1>\n  <form id=\"homeSearch\" class=\"sentence\" aria-label=\"Sentence search\">\n   <div class=\"line\">I'm looking for therapy focused on\n    <select name=\"specialty\" aria-label=\"Specialty\">${opts(SPECIALTIES,\"\",\"any specialty\")}</select>\n   </div>\n   <div class=\"line\">in\n    <select name=\"city\" aria-label=\"City\">${opts(CITIES,\"\",\"any DFW city\")}</select>\n   </div>\n   <div class=\"line\">with a\n    <select name=\"type\" aria-label=\"Practice type\"><option value=\"\">solo or group</option><option value=\"group\">group</option><option value=\"solo\">solo</option></select>\n    practice\n   </div>\n   <div class=\"line\">that takes\n    <select name=\"insurance\" aria-label=\"Insurance\">${insOpts(\"\",\"any insurance\")}</select>.\n   </div>\n   <div class=\"chips\" aria-label=\"Quick specialties\">${[\"emdr\",\"play-therapy\",\"trauma\",\"adhd\",\"couples\"].map(s=>`<button type=\"button\" class=\"chip\" data-chip=\"${s}\" onclick=\"pickChip('${s}',event)\">${SPECIALTIES[s]}</button>`).join(\"\")}</div>\n   <div class=\"actions\" style=\"display:flex;flex-wrap:wrap;gap:.5rem\">\n     <button type=\"button\" class=\"btn\" id=\"showMatches\" data-run-search onclick=\"runHomeSearch(event)\">Search</button>\n     <button type=\"button\" class=\"btn alt\" id=\"resetHome\" data-reset-home onclick=\"resetHomeSearch(event)\">Reset</button>\n   </div>\n  </form></section>\n  <section class=\"card\"><h2>Why ${esc(BRAND)} is different</h2><ul>\n   <li><b>Verified openings</b> \u2014 every listing shows its next opening and when it was last confirmed. Anything older than ${STALE_DAYS} days is flagged.</li>\n   <li><b>Group practices first-class</b> \u2014 see the whole team, and send one request that routes to whoever fits and is free.</li>\n   <li><b>Specialty pages by city</b> \u2014 <a href=\"#/specialty/emdr/frisco\" data-nav=\"/specialty/emdr/frisco\">EMDR in Frisco</a>, <a href=\"#/specialty/play-therapy/mckinney\" data-nav=\"/specialty/play-therapy/mckinney\">Play therapy in McKinney</a>.</li></ul></section>`;\n},\nsearch(){\n  const q=parseQuery(), mode=q.view===\"practices\"?\"practices\":\"clinicians\";\n  const cl=filterClinicians(q), pr=filterPractices(q);\n  return homeBar()+`<h1>Search results</h1>\n  <p class=\"muted\">Showing matches for your filters. Change any filter to update the list.</p><form id=\"filterForm\" class=\"card filters\" aria-label=\"Filters\">\n   <div><label for=\"f-s\">Specialty</label><select id=\"f-s\" name=\"specialty\">${opts(SPECIALTIES,q.specialty,\"Any\")}</select></div>\n   <div><label for=\"f-c\">City</label><select id=\"f-c\" name=\"city\">${opts(CITIES,q.city,\"Any\")}</select></div>\n   <div><label for=\"f-i\">Insurance</label><select id=\"f-i\" name=\"insurance\">${insOpts(q.insurance,\"Any\")}</select></div>\n   <div><label for=\"f-t\">Practice type</label><select id=\"f-t\" name=\"type\"><option value=\"\">Any</option><option value=\"group\"${q.type===\"group\"?\" selected\":\"\"}>Group</option><option value=\"solo\"${q.type===\"solo\"?\" selected\":\"\"}>Solo</option></select></div>\n   <div><label><input type=\"checkbox\" name=\"open\" value=\"1\"${q.open?\" checked\":\"\"} style=\"width:auto\"> Verified openings only</label>\n   <label><input type=\"checkbox\" name=\"tele\" value=\"1\"${q.tele?\" checked\":\"\"} style=\"width:auto\"> Telehealth</label></div>\n   <input type=\"hidden\" name=\"view\" value=\"${mode}\">\n   <div style=\"grid-column:1/-1;display:flex;flex-wrap:wrap;gap:.5rem\">\n     <button type=\"button\" class=\"btn\" data-run-search onclick=\"runFilterSearch(event)\">Search</button>\n     <button type=\"button\" class=\"btn alt\" data-clear-filters onclick=\"clearFilters(event)\">Clear filters</button>\n   </div></form>\n  <div class=\"toggle\" role=\"group\" aria-label=\"Show results as\">\n   <button type=\"button\" aria-pressed=\"${mode===\"clinicians\"}\" data-view=\"clinicians\">Clinicians (${cl.length})</button>\n   <button type=\"button\" aria-pressed=\"${mode===\"practices\"}\" data-view=\"practices\">Group practices (${pr.length})</button></div>\n  ${mode===\"clinicians\"?(cl.map(clinicianCard).join(\"\")||empty()):(pr.map(practiceCard).join(\"\")||empty())}\n  ${pageFoot()}`;\n},\nclinician(id){\n  const c=CLINICIANS.find(x=>x.id===id); if(!c) return views.notfound();\n  const p=practiceOf(c);\n  const practiceBtn = p ? `<button type=\"button\" class=\"btn alt sm\" data-nav=\"/practice/${p.id}\" onclick=\"navigate('/practice/${p.id}',{});return false;\">View practice</button>` : \"\";\n  return `${back(practiceBtn)}<article class=\"card\"><div class=\"row\"><div class=\"avatar\" style=\"background:${color(c.id)};width:96px;height:96px\" aria-hidden=\"true\">${initials(c.name)}</div>\n   <div style=\"flex:1\"><h1 style=\"margin:0\">${esc(c.name)}</h1><div class=\"muted\">${esc(c.cred)} \u00b7 ${CITIES[c.city]}, TX \u00b7 ${p?`Part of <a href=\"#/practice/${p.id}\" data-nav=\"/practice/${p.id}\">${esc(p.name)}</a>`:\"Solo practice\"}</div>\n   ${openingBadge(c)}<p>${esc(c.bio)}</p>\n   <h3>Specialties</h3>${c.specialties.map(s=>`<span class=\"tag\">${SPECIALTIES[s]}</span>`).join(\"\")}\n   <h3>Insurance</h3><p>${c.insurance.join(\", \")}</p><h3>Languages</h3><p>${c.langs.join(\", \")}</p>\n   <p>${c.telehealth?\"Offers telehealth\":\"In person only\"}</p>\n   <div style=\"display:flex;gap:.5rem;flex-wrap:wrap\">\n     <a class=\"btn\" href=\"#/request/clinician/${c.id}\" data-nav=\"/request/clinician/${c.id}\">Request appointment</a>\n     ${favBtn(\"c\",c.id)}\n     ${practiceBtn}\n   </div></div></div></article>${pageFoot()}`;\n},\n/* DIFFERENTIATOR 1: GROUP PRACTICE PAGE WITH FULL TEAM */\npractice(id){\n  const p=PRACTICES.find(x=>x.id===id); if(!p) return views.notfound();\n  const t=teamOf(p);\n  return `${back()}<article class=\"card\"><h1 style=\"margin:0\">${esc(p.name)}</h1>\n   <div class=\"muted\">Group practice \u00b7 ${CITIES[p.city]}, TX \u00b7 ${esc(p.phone)}</div><p>${esc(p.about)}</p>\n   ${practiceOpenings(p)}<p class=\"muted\">Insurance accepted: ${p.insurance.join(\", \")}</p>\n   <div style=\"display:flex;gap:.5rem;flex-wrap:wrap\">\n     <a class=\"btn\" href=\"#/request/practice/${p.id}\" data-nav=\"/request/practice/${p.id}\">One request \u2014 match me to whoever fits</a>\n     ${favBtn(\"p\",p.id)}\n   </div></article>\n   <h2>Our team (${t.length})</h2><div class=\"team\">${t.map(clinicianCard).join(\"\")}</div>\n   ${pageFoot()}`;\n},\n/* DIFFERENTIATOR 4: SPECIALTY-BY-CITY PAGES */\nspecialty(spec,city){\n  if(!SPECIALTIES[spec]||!CITIES[city]) return views.notfound();\n  const cl=filterClinicians({specialty:spec,city});\n  const pr=filterPractices({specialty:spec,city});\n  const near=filterClinicians({specialty:spec}).filter(c=>c.city!==city);\n  return homeBar()+`<h1>${SPECIALTIES[spec]} in ${CITIES[city]}, TX</h1>\n  <div class=\"chips\">${Object.entries(CITIES).map(([k,v])=>`<a class=\"chip${k===city?\" on\":\"\"}\" href=\"#/specialty/${spec}/${k}\">${v}</a>`).join(\"\")}</div>\n  <div class=\"chips\">${[\"emdr\",\"play-therapy\"].map(s=>`<a class=\"chip${s===spec?\" on\":\"\"}\" href=\"#/specialty/${s}/${city}\">${SPECIALTIES[s]}</a>`).join(\"\")}</div>\n  ${pr.length?`<h2>Group practices</h2>${pr.map(practiceCard).join(\"\")}`:\"\"}\n  <h2>Clinicians</h2>${cl.map(clinicianCard).join(\"\")||empty()}\n  ${near.length?`<h2>Nearby in DFW</h2>${near.map(clinicianCard).join(\"\")}`:\"\"}\n  ${pageFoot()}`;\n},\n/* DIFFERENTIATOR 5: SHARED INTAKE / ROUTING */\nrequest(kind,id){\n  const target = kind===\"practice\"?PRACTICES.find(p=>p.id===id):CLINICIANS.find(c=>c.id===id);\n  if(!target) return views.notfound();\n  const team = kind===\"practice\"?teamOf(target):null;\n  const specs = kind===\"practice\"?[...new Set(team.flatMap(c=>c.specialties))]:target.specialties;\n  const backTarget = kind===\"practice\" ? `/practice/${id}` : `/clinician/${id}`;\n  return `${back(`<button type=\"button\" class=\"btn alt sm\" data-nav=\"${backTarget}\" onclick=\"navigate('${backTarget}',{});return false;\">\u2190 Back to listing</button>`)}\n  <section class=\"card\"><h1 style=\"margin-top:0\">Request an appointment</h1>\n  <p>${kind===\"practice\"?`Send one request to <b>${esc(target.name)}</b>. We'll suggest the best-fit clinician on the team with a verified opening.`:`To <b>${esc(target.name)}</b>${target.practice?` \u2014 if they're full, ${esc(practiceOf(target).name)} can route you to a teammate.`:\".\"}`}</p>\n  <div class=\"note\">Please don't include health details. Share only how to reach you; the clinician will follow up privately.</div>\n  <form id=\"reqForm\" data-kind=\"${kind}\" data-target=\"${id}\">\n   <label for=\"r-n\">Name</label><input id=\"r-n\" name=\"name\" required autocomplete=\"name\">\n   <label for=\"r-e\">Email or phone</label><input id=\"r-e\" name=\"contact\" required>\n   <label for=\"r-s\">What kind of help?</label><select id=\"r-s\" name=\"specialty\">${opts(Object.fromEntries(specs.map(s=>[s,SPECIALTIES[s]])),\"\",\"No preference\")}</select>\n   <label for=\"r-i\">Insurance</label><select id=\"r-i\" name=\"insurance\">${insOpts(\"\",\"Not sure / self-pay\")}</select>\n   <label for=\"r-t\">Preferred format</label><select id=\"r-t\" name=\"format\"><option value=\"\">Either</option><option value=\"tele\">Telehealth</option><option value=\"inperson\">In person</option></select>\n   <div class=\"page-actions\">\n     <button type=\"submit\" class=\"btn\">Save request</button>\n     <button type=\"button\" class=\"btn alt\" data-nav=\"${backTarget}\" onclick=\"navigate('${backTarget}',{});return false;\">Cancel</button>\n   </div></form><div id=\"reqResult\" aria-live=\"polite\"></div></section>\n  ${pageFoot()}`;\n},\nsaved(){\n  const f=favs(), cl=CLINICIANS.filter(c=>f.c.includes(c.id)), pr=PRACTICES.filter(p=>f.p.includes(p.id));\n  const reqs=LS.get(\"pp_requests\",[]);\n  return homeBar()+`<h1>Saved</h1><p class=\"muted\">Saved on this device only.</p>\n  <div class=\"page-actions\">\n    ${(f.c.length||f.p.length)?`<button type=\"button\" class=\"btn alt\" data-clear-favs onclick=\"clearFavs(event)\">Clear saved list</button>`:\"\"}\n    ${reqs.length?`<button type=\"button\" class=\"btn alt\" data-clear-reqs onclick=\"clearReqs(event)\">Clear requests</button>`:\"\"}\n  </div>\n  <h2>Practices (${pr.length})</h2>${pr.map(practiceCard).join(\"\")||'<p class=\"muted\">None yet.</p>'}\n  <h2>Clinicians (${cl.length})</h2>${cl.map(clinicianCard).join(\"\")||'<p class=\"muted\">None yet.</p>'}\n  <h2>Requests on this device (${reqs.length})</h2>${reqs.map(r=>`<div class=\"card\"><b>${esc(r.toName)}</b> \u00b7 ${new Date(r.at).toLocaleString()}<br><span class=\"muted\">${esc(r.routedTo?\"Routed to \"+r.routedTo:\"Practice will choose a clinician\")}</span></div>`).join(\"\")||'<p class=\"muted\">None.</p>'}\n  ${pageFoot()}`;\n},\n/* DIFFERENTIATOR 7: PRACTICE SIGN-UP */\njoin(){\n  return homeBar()+`<section class=\"card\"><h1 style=\"margin-top:0\">List your practice on ${esc(BRAND)}</h1>\n  <p>Group practices get one page with the whole team, structured openings, and a shared intake that routes clients to whoever is free.</p>\n  <div class=\"note\"><b>DRAFT \u2014 pricing not final.</b> Idea under discussion: one practice plan priced per active clinician, with solo listings available. Nothing here is an offer.</div>\n  <form id=\"joinForm\">\n   <label for=\"j-p\">Practice name</label><input id=\"j-p\" name=\"practice\" required>\n   <label for=\"j-c\">City</label><select id=\"j-c\" name=\"city\" required>${opts(CITIES,\"\",\"Choose\u2026\")}</select>\n   <label for=\"j-n\">Number of clinicians</label><input id=\"j-n\" name=\"size\" type=\"number\" min=\"1\" required>\n   <label for=\"j-who\">Contact name</label><input id=\"j-who\" name=\"contact\" required>\n   <label for=\"j-e\">Work email</label><input id=\"j-e\" name=\"email\" type=\"email\" required>\n   <label for=\"j-m\">Anything else?</label><textarea id=\"j-m\" name=\"notes\" rows=\"3\"></textarea>\n   <div class=\"page-actions\">\n     <button type=\"submit\" class=\"btn\">Request a listing</button>\n     <button type=\"button\" class=\"btn alt\" data-home onclick=\"goHome(event)\">Cancel</button>\n   </div></form><div id=\"joinResult\" aria-live=\"polite\"></div></section>\n  ${pageFoot()}`;\n},\nnotfound(){return homeBar()+`<section class=\"card\"><h1>Page not found</h1><p>That page doesn't exist or the listing was removed.</p><button type=\"button\" class=\"btn\" data-home onclick=\"goHome(event)\">Go home</button> <button type=\"button\" class=\"btn alt\" data-run-search onclick=\"runHomeSearch(event)\">Search</button></section>`}\n};\nconst homeBar=(extra=\"\")=>`<div class=\"homebar\" role=\"navigation\" aria-label=\"Page navigation\">\n  <button type=\"button\" class=\"btn alt\" data-home onclick=\"goHome(event)\" aria-label=\"Back to homepage\">\u2190 Home</button>\n  <button type=\"button\" class=\"btn alt sm\" data-nav=\"/search\" onclick=\"navigate('/search',{});return false;\">Search</button>\n  ${extra}<span class=\"spacer\"></span>\n</div>`;\nconst back=(extra=\"\")=>homeBar(extra);\nconst empty=()=>`<div class=\"card muted\"><p>No matches. Try removing a filter.</p>\n  <div class=\"page-actions\">\n    <button type=\"button\" class=\"btn\" data-clear-filters onclick=\"clearFilters(event)\">Clear filters</button>\n    <button type=\"button\" class=\"btn alt\" data-home onclick=\"goHome(event)\">\u2190 Home</button>\n  </div></div>`;\nconst pageFoot=()=>`<div class=\"page-actions\">\n  <button type=\"button\" class=\"btn alt\" data-home onclick=\"goHome(event)\">\u2190 Home</button>\n  <button type=\"button\" class=\"btn alt\" data-nav=\"/search\" onclick=\"navigate('/search',{});return false;\">Browse all</button>\n</div>`;\nfunction withHome(html){ return homeBar()+html; }\n\n/* ===== ACTIONS / ROUTER (in-memory \u2014 works when hashchange is blocked) ===== */\nlet ROUTE_PATH = \"/\";\nlet ROUTE_QUERY = {};\n\nfunction readHash(){\n  const raw = (location.hash || \"#/\").replace(/^#/, \"\") || \"/\";\n  const [pathPart, qs] = raw.split(\"?\");\n  const path = pathPart.startsWith(\"/\") ? pathPart : \"/\" + pathPart;\n  const query = Object.fromEntries(new URLSearchParams(qs || \"\"));\n  return {path: path === \"\" ? \"/\" : path, query};\n}\nfunction syncFromHash(){\n  const h = readHash();\n  ROUTE_PATH = h.path;\n  ROUTE_QUERY = h.query;\n}\nfunction navigate(path, query){\n  if(!path.startsWith(\"/\")) path = \"/\" + path;\n  ROUTE_PATH = path || \"/\";\n  ROUTE_QUERY = query || {};\n  const q = toQuery(ROUTE_QUERY);\n  const hash = \"#\" + ROUTE_PATH + (q ? \"?\" + q : \"\");\n  try {\n    if(location.hash !== hash) location.hash = hash;\n    else if(typeof history !== \"undefined\" && history.replaceState){\n      try { history.replaceState(null, \"\", hash); } catch(e) {}\n    }\n  } catch(e) {}\n  route();\n  try { if (typeof window.scrollTo===\"function\") window.scrollTo(0,0); } catch(e) {}\n}\nfunction parseQuery(){ return Object.assign({}, ROUTE_QUERY); }\nfunction setView(v){\n  const q = parseQuery();\n  q.view = v;\n  navigate(\"/search\", q);\n}\nfunction routeIntake(candidates,d){\n  const fits=candidates.filter(c=>isOpen(c)&&(!d.specialty||c.specialties.includes(d.specialty))&&(!d.insurance||c.insurance.includes(d.insurance))&&(d.format!==\"tele\"||c.telehealth));\n  return fits.sort((a,b)=>a.nextOpening.localeCompare(b.nextOpening))[0]||null;\n}\nfunction submitRequest(form,kind,id){\n  const d=Object.fromEntries(new FormData(form));\n  let toName,match;\n  if(kind===\"practice\"){const p=PRACTICES.find(x=>x.id===id);toName=p.name;match=routeIntake(teamOf(p),d)}\n  else{const c=CLINICIANS.find(x=>x.id===id);toName=c.name;match=isOpen(c)?c:(c.practice?routeIntake(teamOf(practiceOf(c)).filter(x=>x.id!==c.id),d):null)}\n  const reqs=LS.get(\"pp_requests\",[]);\n  reqs.push({kind,id,toName,routedTo:match?match.name:null,at:Date.now(),specialty:d.specialty,insurance:d.insurance,format:d.format});\n  LS.set(\"pp_requests\",reqs);\n  form.remove();\n  $(\"#reqResult\").innerHTML=`<div class=\"success\"><b>Request saved on this device \u2014 not sent.</b> This is a prototype; nothing leaves your browser.<br>${\n    match?(match.name===toName?`Best fit: <a href=\"#/clinician/${match.id}\" data-nav=\"/clinician/${match.id}\">${esc(match.name)}</a>, next opening ${fmt(match.nextOpening)}.`:`Routed to <a href=\"#/clinician/${match.id}\" data-nav=\"/clinician/${match.id}\">${esc(match.name)}</a> (${esc(match.cred)}), next opening ${fmt(match.nextOpening)}.`)\n    :\"No one on this team has a verified opening that fits right now; the practice would follow up.\"}\n    <div class=\"page-actions\" style=\"margin-top:.75rem\">\n      <button type=\"button\" class=\"btn\" data-home onclick=\"goHome(event)\">\u2190 Home</button>\n      ${match?`<button type=\"button\" class=\"btn alt\" data-nav=\"/clinician/${match.id}\" onclick=\"navigate('/clinician/${match.id}',{});return false;\">View clinician</button>`:\"\"}\n      <button type=\"button\" class=\"btn alt\" data-nav=\"/saved\" onclick=\"navigate('/saved',{});return false;\">View saved</button>\n    </div></div>`;\n}\nfunction submitJoin(form){\n  const d=Object.fromEntries(new FormData(form));const l=LS.get(\"pp_listings\",[]);l.push({...d,at:Date.now()});LS.set(\"pp_listings\",l);\n  form.remove();$(\"#joinResult\").innerHTML=`<div class=\"success\"><b>Listing request saved on this device \u2014 not sent.</b> Thanks, ${esc(d.contact)}.\n    <div class=\"page-actions\" style=\"margin-top:.75rem\">\n      <button type=\"button\" class=\"btn\" data-home onclick=\"goHome(event)\">\u2190 Home</button>\n      <button type=\"button\" class=\"btn alt\" data-nav=\"/search\" onclick=\"navigate('/search',{});return false;\">Browse directory</button>\n    </div></div>`;\n}\n\nfunction route(){\n  const path = (ROUTE_PATH || \"/\").replace(/^\\//,\"\").split(\"/\").filter(Boolean);\n  const [a,b,c]=path; let html;\n  if(!a) html=views.home();\n  else if(a===\"search\") html=views.search();\n  else if(a===\"clinician\"&&b) html=views.clinician(b);\n  else if(a===\"practice\"&&b) html=views.practice(b);\n  else if(a===\"specialty\"&&b&&c) html=views.specialty(b,c);\n  else if(a===\"request\"&&b&&c) html=views.request(b,c);\n  else if(a===\"saved\") html=views.saved();\n  else if(a===\"join\") html=views.join();\n  else html=views.notfound();\n  $(\"#app\").innerHTML=html;\n  updateCount();\n  updateHomeBtn();\n}\n\n/* Navigation helpers exposed on window for inline onclick backups */\nfunction goHome(e){\n  if(e){ try{e.preventDefault(); e.stopPropagation();}catch(err){} }\n  navigate(\"/\");\n}\nfunction collectForm(form){\n  const o = {};\n  if(!form) return o;\n  form.querySelectorAll(\"select[name], input[name], textarea[name]\").forEach(el=>{\n    const name = el.getAttribute(\"name\");\n    if(!name) return;\n    if(el.type === \"checkbox\"){ if(el.checked) o[name] = el.value || \"1\"; return; }\n    if(el.type === \"radio\"){ if(el.checked) o[name] = el.value; return; }\n    const v = (el.value || \"\").trim();\n    if(v) o[name] = v;\n  });\n  return o;\n}\nfunction runHomeSearch(e){\n  if(e){ try{e.preventDefault(); e.stopPropagation();}catch(err){} }\n  const form = document.getElementById(\"homeSearch\") || document.getElementById(\"filterForm\");\n  if(form){ goSearch(form); return; }\n  navigate(\"/search\", {});\n}\nfunction runFilterSearch(e){\n  if(e){ try{e.preventDefault(); e.stopPropagation();}catch(err){} }\n  const form = document.getElementById(\"filterForm\") || document.getElementById(\"homeSearch\");\n  if(form) goSearch(form); else navigate(\"/search\", {});\n}\nfunction pickChip(spec, e){\n  if(e){ try{e.preventDefault(); e.stopPropagation();}catch(err){} }\n  const form = document.getElementById(\"homeSearch\");\n  if(form){\n    const sel = form.querySelector('select[name=\"specialty\"]');\n    if(sel) sel.value = spec;\n    goSearch(form);\n  } else navigate(\"/search\", {specialty: spec});\n}\n\nfunction resetHomeSearch(e){\n  if(e){ try{e.preventDefault(); e.stopPropagation();}catch(err){} }\n  const form = document.getElementById(\"homeSearch\");\n  if(!form) return;\n  form.querySelectorAll(\"select\").forEach(s => { s.selectedIndex = 0; });\n}\nfunction clearFilters(e){\n  if(e){ try{e.preventDefault(); e.stopPropagation();}catch(err){} }\n  navigate(\"/search\", {});\n}\nfunction clearFavs(e){\n  if(e){ try{e.preventDefault(); e.stopPropagation();}catch(err){} }\n  if(!confirm(\"Clear all saved clinicians and practices on this device?\")) return;\n  LS.set(\"pp_favs\", {c:[], p:[]});\n  updateCount();\n  route();\n}\nfunction clearReqs(e){\n  if(e){ try{e.preventDefault(); e.stopPropagation();}catch(err){} }\n  if(!confirm(\"Clear all appointment requests saved on this device?\")) return;\n  LS.set(\"pp_requests\", []);\n  route();\n}\nwindow.resetHomeSearch = resetHomeSearch;\nwindow.clearFilters = clearFilters;\nwindow.clearFavs = clearFavs;\nwindow.clearReqs = clearReqs;\nwindow.goHome = goHome;\nwindow.runHomeSearch = runHomeSearch;\nwindow.runFilterSearch = runFilterSearch;\nwindow.pickChip = pickChip;\nwindow.navigate = navigate;\n\nfunction goSearch(form){\n  const o = collectForm(form);\n  if(ROUTE_QUERY.view) o.view = ROUTE_QUERY.view;\n  navigate(\"/search\", o);\n}\n\nfunction updateHomeBtn(){\n  const btn = document.getElementById(\"homeBtn\");\n  if(!btn) return;\n  const onHome = !ROUTE_PATH || ROUTE_PATH === \"/\";\n  btn.style.display = onHome ? \"none\" : \"inline-flex\";\n}\n\ndocument.addEventListener(\"click\", function(e){\n  const t = e.target;\n  if(!t || !t.closest) return;\n\n  const home = t.closest(\"[data-home]\");\n  if(home){ e.preventDefault(); goHome(e); return; }\n\n  if(t.closest(\"[data-reset-home]\")){ e.preventDefault(); resetHomeSearch(e); return; }\n  if(t.closest(\"[data-clear-filters]\")){ e.preventDefault(); clearFilters(e); return; }\n  if(t.closest(\"[data-clear-favs]\")){ e.preventDefault(); clearFavs(e); return; }\n  if(t.closest(\"[data-clear-reqs]\")){ e.preventDefault(); clearReqs(e); return; }\n\n  const run = t.closest(\"[data-run-search]\");\n  if(run){\n    e.preventDefault();\n    if(document.getElementById(\"filterForm\") && !document.getElementById(\"homeSearch\")) runFilterSearch(e);\n    else runHomeSearch(e);\n    return;\n  }\n\n  const backBtn = t.closest(\"[data-back]\");\n  if(backBtn){ e.preventDefault(); goHome(e); return; }\n\n  const fav = t.closest(\"[data-fav]\");\n  if(fav){\n    e.preventDefault();\n    toggleFav(fav.getAttribute(\"data-fav\"), fav.getAttribute(\"data-id\"));\n    return;\n  }\n\n  const viewBtn = t.closest(\"[data-view]\");\n  if(viewBtn){ e.preventDefault(); setView(viewBtn.getAttribute(\"data-view\")); return; }\n\n  const chip = t.closest(\"[data-chip]\");\n  if(chip){ e.preventDefault(); pickChip(chip.getAttribute(\"data-chip\"), e); return; }\n\n  const nav = t.closest(\"[data-nav]\");\n  if(nav){\n    e.preventDefault();\n    const path = nav.getAttribute(\"data-nav\") || \"/\";\n    navigate(path, {});\n    return;\n  }\n\n  const a = t.closest('a[href^=\"#\"]');\n  if(a){\n    e.preventDefault();\n    const href = a.getAttribute(\"href\") || \"#/\";\n    const raw = href.replace(/^#/, \"\") || \"/\";\n    const [pathPart, qs] = raw.split(\"?\");\n    const path = pathPart.startsWith(\"/\") ? pathPart : \"/\" + pathPart;\n    const query = Object.fromEntries(new URLSearchParams(qs || \"\"));\n    navigate(path || \"/\", query);\n  }\n}, true);\n\ndocument.addEventListener(\"submit\", function(e){\n  const form = e.target;\n  if(!(form instanceof HTMLFormElement)) return;\n  if(form.id === \"homeSearch\" || form.id === \"filterForm\"){\n    e.preventDefault();\n    goSearch(form);\n    return;\n  }\n  if(form.id === \"reqForm\"){\n    e.preventDefault();\n    submitRequest(form, form.getAttribute(\"data-kind\"), form.getAttribute(\"data-target\"));\n    return;\n  }\n  if(form.id === \"joinForm\"){\n    e.preventDefault();\n    submitJoin(form);\n  }\n}, true);\n\ndocument.addEventListener(\"change\", function(e){\n  const form = e.target && e.target.closest && e.target.closest(\"#filterForm\");\n  if(form) goSearch(form);\n}, true);\n\ndocument.title = BRAND + \" \u2014 Find therapists, psychiatrists & group practices\";\n$(\"#logo\").textContent = BRAND;\nwindow.addEventListener(\"hashchange\", () => { syncFromHash(); route(); try{ if(typeof window.scrollTo===\"function\") window.scrollTo(0,0);}catch(e){} });\nwindow.addEventListener(\"popstate\", () => { syncFromHash(); route(); });\nsyncFromHash();\nupdateCount();\nroute();\n</script>\n</body>\n</html>\n"}]}